# Without a key, typed ideas run a labelled simulation and cost nothing.
# With a key, typed ideas run live on real Claude models. Set a spend limit in the
# Anthropic console too: the in-code limits below are a brake, not a hard cap.
ANTHROPIC_API_KEY=

# Set to "off" to turn live runs off even when a key is present.
FOUNDRY_LIVE=on

# Best-effort limits for live runs (per visitor per hour, and per day for the whole site).
# A live run costs roughly 5 to 10 cents.
FOUNDRY_LIVE_PER_HOUR=1
FOUNDRY_LIVE_PER_DAY=8

# Models for live runs. Defaults shown. Fable 5.1 costs about 5x more than Sonnet 5.5.
FOUNDRY_MODEL_SMART=claude-sonnet-5-5
FOUNDRY_MODEL_BUILD=claude-sonnet-5-5
FOUNDRY_MODEL_FAST=claude-haiku-5-5

# Turns on the admin dashboard at /admin. Leave empty to keep it off (the page then returns 404).
# Use a long random value, for example the output of: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Sandbox snapshot id for the real browser step (see README). Not secret, but only valid for this Vercel project.
FOUNDRY_SANDBOX_SNAPSHOT=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
CRON_SECRET=
